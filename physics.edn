;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a document-handling and coordination robot
;; manages training schedules, readiness reporting and administrative
;; correspondence for non-commissioned armed forces officers (ISCO 0210).
;; Its physical work is moving paper stock and keeping records safe:
;; restocking copy-paper cartons onto the supply shelf, and holding
;; readiness records in a fire-rated records cabinet.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-0210"
 :cases
 [{:id :paper-carton-restock
   :kind :manipulator
   :procedure "arm lifts a copy-paper carton from the delivery pallet onto the orderly-room supply shelf"
   :params {:l1-m 0.60 :l2-m 0.55 :m1-kg 8.0 :m2-kg 6.0
            :from [0.70 0.05] :to [0.35 0.90] :duration-s 3.0 :steps 450}
   :sweep {:param :payload-kg :values [2.5 5.0 10.0 15.0 25.0]}
   :quantity :peak-tau1-nm
   :limit {:max 200.0 :basis "estimate: continuous shoulder torque of a ~15 kg-payload collaborative arm"}
   :boundary {:lo 0.5 :hi 60.0}}
  {:id :records-cabinet-fire
   :kind :thermal
   :procedure "fire-rated records cabinet holding readiness files is engulfed in a 900 C room fire; its insulated wall must keep the paper inside from charring"
   :params {:conductivity-w-mk 0.20 :density-kg-m3 900.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 900.0 :h-front-w-m2k 25.0 :t-back-ambient-c 20.0 :h-back-w-m2k 3.0
            :threshold-c 177.0 :duration-s 3600.0 :nodes 21}
   :sweep {:param :thickness-m :values [0.02 0.03 0.04 0.06 0.08]}
   :quantity :final-back-c
   :limit {:max 177.0 :basis "UL 72 Class 350 record container: interior must stay below 350 F (177 C) for the rated exposure (here held to a constant 900 C gas, harsher than the standard time-temperature curve at early times)"}
   :boundary {:lo 0.01 :hi 0.12}}]}
